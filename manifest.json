{
  "manifest_version": 3,
  "name": "UTEX Risk/Reward Tool",
  "version": "0.2.0",
  "description": "Entry / SL / TP lines on the UTEX chart with ±10 shares buttons and live $ risk/reward from the current price.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "UTEX R/R — показать/убрать инструмент",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": ["activeTab", "scripting"],
  "content_scripts": [
    {
      "matches": ["https://margin.utex.io/*"],
      "js": [
        "src/calc.js",
        "src/settings.js",
        "src/logo.js",
        "src/chart-bridge.js",
        "src/lines.js",
        "src/order-form.js",
        "src/styles.js",
        "src/overlay.js",
        "src/main.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
